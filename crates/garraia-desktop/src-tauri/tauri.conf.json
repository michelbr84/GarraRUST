{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "garraia-desktop",
  "identifier": "org.garraia.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/michelbr84/GarraRUST/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENkQ1OTYyNDgyODgzRTcKUldUbmd5aElZbGx0ZlNjMTd1NzFaTDRLWll5Z21QakhIV09FVnVCY1pCSFZIYXFNSXI2VEREWEYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/garraia"
    ],
    "resources": {
      "resources/config.default.yml": "resources/config.default.yml",
      "node-runtime/node": "node",
      "node-runtime/bridge-whatsapp": "bridge-whatsapp",
      "node-runtime/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "node-runtime/manifest.json": "manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    },
    "linux": {
      "deb": {
        "provides": [
          "garraia"
        ],
        "conflicts": [
          "garraia"
        ],
        "replaces": [
          "garraia"
        ]
      },
      "rpm": {
        "provides": [
          "garraia"
        ],
        "conflicts": [
          "garraia"
        ]
      }
    }
  }
}
